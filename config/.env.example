# ==============================================================================
# OnlineJobs.ph Automation Suite - Environment Configuration
# Copy this file to .env and configure your credentials.
# ==============================================================================

# OnlineJobs.ph Account Credentials
# (Optional: Unauthenticated scraping works for public job searches without credentials)
OJP_EMAIL=your_email@example.com
OJP_PASSWORD=your_password_here

# Local Web Server & API Configuration
PORT=5050
HOST=0.0.0.0
DEBUG=False

# MCP (Model Context Protocol) Server Port (for SSE / Streamable HTTP transports)
MCP_PORT=5055

# Optional Shared Secret for Cron / Webhook Scraper Triggers
# Protects the /api/scrape endpoint when triggered via GitHub Actions or cloud schedulers
CRON_SECRET=

# Optional Cloud Storage Persistence (for serverless containers e.g. Google Cloud Run)
# Leave empty to persist jobs.db locally on disk
GCS_BUCKET=
GCS_OBJECT=jobs.db

# Application Routes Configuration
ZERO_CONNECTS_ONLY=true
FROM_EMAIL=your_email@example.com
RESUME_PDF_PATH=config/resume.pdf

# Optional SMTP Email Dispatch Configuration (Route A: Direct Email Applications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_specific_password

# Playwright Browser Automation Options
HEADLESS=true
BROWSER_TIMEOUT=30000
